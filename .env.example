###############################################################################
# Configuration Airflow AMUE - Exemple
# Copiez ce fichier vers .env et remplissez les valeurs
# ATTENTION: Ne commitez JAMAIS le fichier .env !
###############################################################################

# ============================================================================
# AIRFLOW CONFIGURATION
# ============================================================================

# User ID pour les fichiers Airflow (utiliser: echo $UID)
AIRFLOW_UID=1001

# Image Docker Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.3

# Clé de chiffrement Fernet (générée automatiquement par le setup)
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# Credentials interface Web Airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Packages Python additionnels
_PIP_ADDITIONAL_REQUIREMENTS=requests oauthlib requests-oauthlib

# ============================================================================
# ENVIRONNEMENT
# ============================================================================

# Environnement (dev ou production)
# dev = utilise sandbox.api.amue.fr
# production = utilise api.amue.fr
AMUE_ENVIRONMENT=dev

# ============================================================================
# AMUE API CONFIGURATION
# ============================================================================

# URLs de l'API (définies automatiquement selon AMUE_ENVIRONMENT)
# Dev:  https://sandbox.api.amue.fr, https://sandbox.auth.amue.fr
# Prod: https://api.amue.fr, https://auth.amue.fr
AMUE_API_HOST=https://sandbox.api.amue.fr
AMUE_TOKEN_URL=https://sandbox.auth.amue.fr/auth/fer/oauth/token

# Credentials OAuth (OBLIGATOIRE - ne pas commiter)
OAUTH_CLIENT_ID=your_client_id_here
OAUTH_CLIENT_SECRET=your_client_secret_here

# ============================================================================
# POSTGRESQL AIRFLOW DATABASE (interne)
# ============================================================================

# Database pour les métadonnées Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ============================================================================
# POSTGRESQL DATA DATABASE (données métier)
# ============================================================================

# Host de la base de données
POSTGRES_DATA_HOST=postgres-data

# Nom de la base et schéma
POSTGRES_DATA_DB=business_data
POSTGRES_DATA_SCHEMA=public
POSTGRES_DATA_PORT=5432

# Credentials (OBLIGATOIRE - ne pas commiter)
POSTGRES_DATA_LOGIN=datauser
POSTGRES_DATA_PASSWORD=your_password_here

# ============================================================================
# SMTP CONFIGURATION
# ============================================================================

# En dev: mailhog (port 1025) - emails visibles sur http://localhost:8025
# En prod: votre serveur SMTP réel
SMTP_HOST=mailhog
SMTP_PORT=1025

# ============================================================================
# CHEMINS (optionnel)
# ============================================================================

# Répertoire du projet (défaut: répertoire courant)
AIRFLOW_PROJ_DIR=.
