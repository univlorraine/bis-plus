# Airflow Environment Variables
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins

# ============================================================================
# AIRFLOW CONFIGURATION
# ============================================================================

# User ID pour les fichiers Airflow (utiliser: echo $UID)
AIRFLOW_UID=1001

# Image Docker Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.3

# Credentials interface Web Airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Packages Python additionnels
_PIP_ADDITIONAL_REQUIREMENTS=requests oauthlib requests-oauthlib

# ============================================================================
# POSTGRESQL AIRFLOW DATABASE
# ============================================================================

# Database pour les métadonnées Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ============================================================================
# POSTGRESQL DATA DATABASE
# ============================================================================

# Database pour les données métier
POSTGRES_DATA_USER=datauser
POSTGRES_DATA_PASSWORD=datapass
POSTGRES_DATA_DB=business_data

# ============================================================================
# CHEMINS
# ============================================================================

# Répertoire du projet (défaut: répertoire courant)
AIRFLOW_PROJ_DIR=.

# Fichier de configuration d'environnement
ENV_FILE_PATH=.env