###############################################################################
# Configuration Airflow AMUE - Exemple
# Copiez ce fichier vers .env et remplissez les valeurs
# ATTENTION: Ne commitez JAMAIS le fichier .env !
#
# Ce fichier contient UNIQUEMENT les variables nécessaires au démarrage
# des containers Docker. Les connexions applicatives (OAuth, PostgreSQL,
# Oracle) sont stockées directement dans la base de données Airflow
# (chiffrées avec la clé Fernet) et ne figurent PAS ici.
# Utilisez `./manage.sh conn-update` pour les modifier après installation.
###############################################################################

# ============================================================================
# AIRFLOW CONFIGURATION
# ============================================================================

# User ID pour les fichiers Airflow (utiliser: echo $UID)
AIRFLOW_UID=1001

# Image Docker Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.7

# Clé de chiffrement Fernet (générée automatiquement par le setup)
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# Credentials interface Web Airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=<CHANGE_ME_MIN_12_CHARS>

# Packages Python additionnels
_PIP_ADDITIONAL_REQUIREMENTS="requests oauthlib requests-oauthlib oracledb"

# ============================================================================
# POSTGRESQL AIRFLOW DATABASE (interne — métadonnées Airflow)
# ============================================================================

POSTGRES_USER=airflow
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=airflow

# ============================================================================
# SMTP CONFIGURATION
# ============================================================================

# En dev: mailhog (port 1025) - emails visibles sur http://localhost:8025
# En prod: votre serveur SMTP réel
SMTP_HOST=mailhog
SMTP_PORT=1025

# ============================================================================
# POSTGRESQL DONNÉES (port mappé sur le host)
# ============================================================================

# Port host pour postgres-data (défaut: 5433, intérieur Docker: 5432)
# Modifier si le port 5433 est déjà utilisé sur votre machine.
PG_DATA_PORT=5433

# Credentials PostgreSQL données métier (docker-compose postgres-data)
PG_DATA_USER=datauser
PG_DATA_PASSWORD=<CHANGE_ME>
PG_DATA_DB=business_data

# ============================================================================
# CHEMINS (optionnel)
# ============================================================================

# Répertoire du projet (défaut: répertoire courant)
AIRFLOW_PROJ_DIR=.
