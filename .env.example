###############################################################################
# Configuration Airflow AMUE - Exemple
# Copiez ce fichier vers .env et remplissez les valeurs
# ATTENTION: Ne commitez JAMAIS le fichier .env !
#
# Ce fichier contient UNIQUEMENT les variables nécessaires au démarrage
# des containers Docker. Les connexions applicatives (OAuth, PostgreSQL,
# Oracle) sont stockées directement dans la base de données Airflow
# (chiffrées avec la clé Fernet) et ne figurent PAS ici.
# Utilisez `./manage.sh conn-update` pour les modifier après installation.
###############################################################################

# ============================================================================
# AIRFLOW CONFIGURATION
# ============================================================================

# User ID pour les fichiers Airflow (utiliser: echo $UID)
AIRFLOW_UID=1001

# Image Docker Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.7

# Clé de chiffrement Fernet (générée automatiquement par le setup)
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# Credentials interface Web Airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=<CHANGE_ME_MIN_12_CHARS>

# Packages Python additionnels
_PIP_ADDITIONAL_REQUIREMENTS="-r /opt/airflow/requirements.txt"

# ============================================================================
# POSTGRESQL AIRFLOW DATABASE (interne — métadonnées Airflow)
# ============================================================================

POSTGRES_USER=airflow
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=airflow

# ============================================================================
# SMTP CONFIGURATION
# ============================================================================

# En dev: mailhog (port 1025) - emails visibles sur http://localhost:8025
# En prod: votre serveur SMTP réel
SMTP_HOST=mailhog
SMTP_PORT=1025

# ============================================================================
# POSTGRESQL DONNÉES (port mappé sur le host)
# ============================================================================

# Port host pour postgres-data (défaut: 5433, intérieur Docker: 5432)
# Modifier si le port 5433 est déjà utilisé sur votre machine.
PG_DATA_PORT=5433

# Credentials PostgreSQL données métier (docker-compose postgres-data)
PG_DATA_USER=datauser
PG_DATA_PASSWORD=<CHANGE_ME>
PG_DATA_DB=business_data

# ============================================================================
# AUTHENTIFICATION CAS (optionnel — fallback AUTH_DB si absent)
# ============================================================================

# URL du serveur CAS de l'université (ex: https://cas.univ-lorraine.fr)
CAS_SERVER_URL=

# Version du protocole CAS : 2 ou 3 (défaut: 2)
CAS_VERSION=2

# Rôle attribué aux nouveaux utilisateurs à leur première connexion
# Valeurs possibles : Admin, Op, User, Viewer (défaut: Viewer)
CAS_DEFAULT_ROLE=Viewer

# URL de callback CAS (laisser vide = auto-détection)
CAS_SERVICE_URL=

# Usernames autorisés à se connecter, séparés par des virgules.
# Vide = tous les comptes CAS peuvent se connecter.
# Exemple : CAS_ALLOWED_USERS=p08315,jdupont,mmartin
CAS_ALLOWED_USERS=

# Usernames qui peuvent avoir le rôle Admin, séparés par des virgules.
# Seuls ces utilisateurs sont autorisés à être Admin ; toute tentative de
# promotion d'un autre utilisateur est bloquée (couche B) et annulée à
# la prochaine connexion (couche A).
# Vide = aucune restriction sur le rôle Admin (comportement héritage).
# Exemple : CAS_ADMIN_USERS=p08315
CAS_ADMIN_USERS=

# ============================================================================
# CHEMINS (optionnel)
# ============================================================================

# Répertoire du projet (défaut: répertoire courant)
AIRFLOW_PROJ_DIR=.

# ============================================================================
# MISE À JOUR (./manage.sh update — optionnel)
# ============================================================================

# Token GitHub (PAT classique ou fine-grained avec accès "Contents: read")
# pour interroger l'API des releases du dépôt GitHub du projet.
# Nécessaire UNIQUEMENT si ce dépôt est privé : sans token, l'API GitHub
# renvoie 404 (pas 403) aux requêtes anonymes pour ne pas révéler son existence.
# Voir docs/UPGRADE.md.
GITHUB_TOKEN=
